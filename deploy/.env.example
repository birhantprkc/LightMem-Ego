# Copy this file to .env. Never commit the copy with real credentials.

FRONTEND_PORT=8080
BACKEND_PORT=8000
VITE_API_BASE_URL=/api

# Remote OpenAI-compatible LLM. Required for memory construction and QA.
OPENAI_API_KEY=replace-with-your-key
OPENAI_BASE_URL=https://your-openai-compatible-endpoint.example/v1
EM2MEM_MEMORY_MODEL=your-memory-model
EM2MEM_QUERY_RESPOND_MODEL=your-query-model
EM2MEM_MST_REFINE_MODEL=your-refine-model
EM2MEM_MST_EPISODIC_MODEL=your-episodic-model
EM2MEM_EVIDENCE_CAPTION_BACKEND=openai

EM2MEM_API_HOST=0.0.0.0
EM2MEM_API_PORT=8000
EM2MEM_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
EM2MEM_PIPELINE_MODE=mst
EM2MEM_AUTO_PREPROCESS=1
EM2MEM_AUTO_MEMORY=1
EM2MEM_AUTO_MST_CONSOLIDATION=1

# ASR uses the Xfyun WebAPI. Credentials are intentionally blank: each
# deployment must provide its own Xfyun account in the local, untracked .env.
EM2MEM_STREAM_ASR_ENABLED=1
EM2MEM_STREAM_ASR_BACKEND=xfyun
EM2MEM_AUDIO_ASR_ENABLED=1
EM2MEM_AUDIO_ASR_BACKEND=xfyun
EM2MEM_VOICE_QUESTION_ASR_BACKEND=xfyun
EM2MEM_SKIP_ASR=0
EM2MEM_XFYUN_APP_ID=
EM2MEM_XFYUN_API_KEY=
EM2MEM_XFYUN_API_SECRET=
EM2MEM_PREPROCESS_ASR_BACKEND=xfyun

# Use mock for a container smoke test, remote for an external VLM2Vec service,
# or profile=models for the optional GPU model-service container.
EM2MEM_VISUAL_BACKEND=mock
EM2MEM_AUTO_VISUAL_EMBEDDING=1
EM2MEM_VLM2VEC_EMBED_URL=http://vlm2vec:18091
EM2MEM_VLM2VEC_MODEL_PATH=/data/em2mem/models/VLM2Vec-V2.0

# Full text retrieval needs a Qwen3-compatible embedding service. `local`
# avoids a startup wait when no embedding model is installed; switch to
# `remote` when using the Compose model service or your own endpoint.
EM2MEM_TEXT_EMBED_BACKEND=local
EM2MEM_TEXT_EMBED_URL=http://text-embedding:18096
EM2MEM_TEXT_EMBED_MODEL=/data/em2mem/models/Qwen3-Embedding-4B

MODEL_DIR=./docker-data/models

SRS_RTMP_PORT=1935
SRS_HTTP_API_PORT=1985
SRS_HTTP_SERVER_PORT=8081
SRS_RTC_UDP_PORT=8000
